{
    "name": "@flippo-software/utils",
    "type": "module",
    "version": "1.1.1",
    "source": "./src/index.ts",
    "packageManager": "pnpm@12.4.1",
    "description": "",
    "author": "",
    "license": "ISC",
    "keywords": [],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "publishConfig": {
        "main": "./dist/index.js",
        "module": "./dist/index.mjs",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "import": {
                    "types": "./dist/index.d.mts",
                    "default": "./dist/index.mjs"
                },
                "require": {
                    "types": "./dist/index.d.ts",
                    "default": "./dist/index.js"
                }
            }
        },
        "access": "public"
    },
    "files": [
        "README.md",
        "dist"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint:check": "biome check",
        "lint:fix": "biome lint --fix && biome format --fix",
        "build": "tsdown",
        "prepare": "simple-git-hooks",
        "hooks:install": "simple-git-hooks"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.13",
        "@flippo-software/biome": "^1.0.0",
        "@flippo-software/tsconfig": "^1.0.0",
        "@types/node": "^22.18.0",
        "simple-git-hooks": "2.14.0",
        "tsdown": "^0.23.0",
        "typescript": "^7.0.2"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/FlippoSoftware/utils.git"
    },
    "homepage": "https://github.com/FlippoSoftware/utils#readme",
    "bugs": {
        "url": "https://github.com/FlippoSoftware/utils/issues"
    },
    "sideEffects": false,
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./areArraysEqual": {
            "import": "./dist/areArraysEqual.js",
            "require": "./dist/areArraysEqual.cjs"
        },
        "./clamp": {
            "import": "./dist/clamp.js",
            "require": "./dist/clamp.cjs"
        },
        "./contains": {
            "import": "./dist/contains.js",
            "require": "./dist/contains.cjs"
        },
        "./createEventEmitter": {
            "import": "./dist/createEventEmitter.js",
            "require": "./dist/createEventEmitter.cjs"
        },
        "./detectBrowser": {
            "import": "./dist/detectBrowser.js",
            "require": "./dist/detectBrowser.cjs"
        },
        "./formatNumber": {
            "import": "./dist/formatNumber.js",
            "require": "./dist/formatNumber.cjs"
        },
        "./getPseudoElementBounds": {
            "import": "./dist/getPseudoElementBounds.js",
            "require": "./dist/getPseudoElementBounds.cjs"
        },
        "./getTarget": {
            "import": "./dist/getTarget.js",
            "require": "./dist/getTarget.cjs"
        },
        "./isElementDisabled": {
            "import": "./dist/isElementDisabled.js",
            "require": "./dist/isElementDisabled.cjs"
        },
        "./isOverflowElement": {
            "import": "./dist/isOverflowElement.js",
            "require": "./dist/isOverflowElement.cjs"
        },
        "./noop": {
            "import": "./dist/noop.js",
            "require": "./dist/noop.cjs"
        },
        "./owner": {
            "import": "./dist/owner.js",
            "require": "./dist/owner.cjs"
        },
        "./randomId": {
            "import": "./dist/randomId.js",
            "require": "./dist/randomId.cjs"
        },
        "./set": {
            "import": "./dist/set.js",
            "require": "./dist/set.cjs"
        },
        "./package.json": "./package.json"
    },
    "simple-git-hooks": {
        "pre-commit": "test \"$(git symbolic-ref --quiet HEAD)\" != refs/heads/main || { echo \"Direct commits to main are not allowed. Create a feature branch.\" >&2; exit 1; }",
        "pre-merge-commit": "test \"$(git symbolic-ref --quiet HEAD)\" != refs/heads/main || { echo \"Local merge commits on main are not allowed. Open a pull request.\" >&2; exit 1; }",
        "pre-push": "while read -r local_ref local_sha remote_ref remote_sha; do if [ \"$remote_ref\" = refs/heads/main ]; then echo \"Direct pushes to main are not allowed. Open a pull request.\" >&2; exit 1; fi; done",
        "preserveUnused": true
    }
}
